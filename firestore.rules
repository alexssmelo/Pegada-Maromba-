rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function membro(g) { return exists(/databases/$(database)/documents/gyms/$(g)/members/$(request.auth.uid)); }
    function papel(g) { return get(/databases/$(database)/documents/gyms/$(g)/members/$(request.auth.uid)).data.role; }
    function ehEquipe(g) { return logado() && membro(g) && papel(g) in ['owner', 'coach']; }
    function ehDono(g) { return logado() && membro(g) && papel(g) == 'owner'; }
    function ehProprio(uid) { return logado() && request.auth.uid == uid; }
    function conviteOk(g, c, r) { return get(/databases/$(database)/documents/invites/$(c)).data.gymId == g && get(/databases/$(database)/documents/invites/$(c)).data.ativo == true && get(/databases/$(database)/documents/invites/$(c)).data.get('papel', 'student') == r; }
    match /users/{uid}/{document=**} { allow read, write: if ehProprio(uid); }
    match /invites/{code} {
      allow get: if logado();
      allow create: if logado() && ehEquipe(request.resource.data.gymId) && (request.resource.data.get('papel', 'student') == 'student' || ehDono(request.resource.data.gymId));
      allow update, delete: if logado() && ehEquipe(resource.data.gymId);
    }
    match /gyms/{gymId} {
      allow read: if logado() && membro(gymId);
      allow create: if logado() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if ehDono(gymId);
      match /members/{uid} {
        allow read: if ehProprio(uid) || ehEquipe(gymId);
        allow create: if (ehProprio(uid) && request.resource.data.role == 'owner' && get(/databases/$(database)/documents/gyms/$(gymId)).data.ownerUid == request.auth.uid)
          || (ehProprio(uid) && request.resource.data.role in ['student', 'coach'] && conviteOk(gymId, request.resource.data.inviteCode, request.resource.data.role))
          || (ehDono(gymId) && request.resource.data.role in ['coach', 'student']);
        allow update: if ehDono(gymId) && uid != request.auth.uid;
        allow delete: if ehDono(gymId) || ehProprio(uid);
      }
      match /students/{uid} {
        allow read: if ehProprio(uid) || ehEquipe(gymId);
        allow create: if (ehProprio(uid) && membro(gymId)) || ehEquipe(gymId);
        allow update: if ehEquipe(gymId) || (ehProprio(uid) && membro(gymId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'coachUid']));
        allow delete: if ehEquipe(gymId) || ehProprio(uid);
        match /plans/{id} { allow read: if ehProprio(uid) || ehEquipe(gymId); allow write: if ehEquipe(gymId); }
        match /assessments/{id} { allow read: if ehProprio(uid) || ehEquipe(gymId); allow write: if ehEquipe(gymId); }
        match /workouts/{id} { allow read: if ehProprio(uid) || ehEquipe(gymId); allow write: if ehProprio(uid) && membro(gymId); }
        match /consent/{id} { allow read: if ehProprio(uid) || ehEquipe(gymId); allow create, update: if ehProprio(uid); }
      }
      match /templates/{id} { allow read, write: if ehEquipe(gymId); }
    }
  }
}
